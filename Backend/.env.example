# Student360Pro - Environment Configuration Template
# Copy this file to .env and fill in with your actual values

# ===== CRITICAL SECURITY SETTINGS =====
# IMPORTANT: Use a strong, randomly generated SECRET_KEY
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secure-random-secret-key-here-change-this

# ===== DATABASE CONFIGURATION =====
# SQLite (default, good for development)
DATABASE_URL=sqlite:///database.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/student360pro

# ===== CORS & ORIGIN CONFIGURATION =====
# Set this to your frontend URL
CORS_ORIGIN=http://localhost:8000

# ===== SESSION & SECURITY SETTINGS =====
# Set to True in production with HTTPS enabled
SESSION_COOKIE_SECURE=False

# ===== OPTIONAL: EMAIL CONFIGURATION =====
# (For future password reset functionality)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# ===== LOGGING CONFIGURATION =====
# LOG_LEVEL=INFO
